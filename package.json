{
  "name": "plumbago-hugo-ui",
  "version": "0.9.0",
  "description": "Plumbago: a friendly Hugo UI manager for Windows and WSL",
  "desktopName": "plumbago.desktop",
  "author": "Plumbago contributors",
  "license": "GPL-3.0-only",
  "homepage": "https://gabuvns.github.io/plumbago/",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gabuvns/plumbago.git"
  },
  "plumbago": {
    "githubOAuthClientId": ""
  },
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && electron . --dev\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "eslint . && vite build",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "blake3-wasm": "2.1.5",
    "diff": "8.0.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "4.0.3",
    "mime-types": "2.1.35",
    "turndown": "7.2.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "dompurify": "3.4.13",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "lucide-react": "0.468.0",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.3",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "dev.gabu.plumbago",
    "productName": "Plumbago",
    "electronUpdaterCompatibility": ">= 2.16",
    "copyright": "Copyright © 2026 Plumbago contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "syncDesktopName": true,
      "synopsis": "A friendly Hugo UI manager",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "gabuvns",
      "repo": "plumbago",
      "releaseType": "release"
    }
  }
}
