{
  "name": "plum-hugo-ui",
  "version": "0.1.0",
  "description": "Plum: a friendly Hugo UI manager for Windows and WSL",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && electron . --dev\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "eslint . && vite build",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "@eslint/js": "9.16.0",
    "concurrently": "9.1.0",
    "dompurify": "3.4.13",
    "electron": "31.7.7",
    "electron-builder": "25.1.8",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "lucide-react": "0.468.0",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.21",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "art.plum.hugo",
    "productName": "Plum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
